# ContestantPortal (Vite + React)
# Copy sang .env rồi chỉnh cho môi trường của bạn:  cp .env.example .env
#
# Chỉ biến có tiền tố VITE_ mới được nhúng vào bundle. Mọi giá trị ở đây đều
# public sau khi build — tuyệt đối không đặt secret vào file này.
#
# Runtime override: envService đọc window.__ENV__ trước, rồi mới tới
# import.meta.env. Deployment có thể inject window.__ENV__ để đổi các giá trị
# dưới đây mà không cần build lại image.

# ── API ────────────────────────────────────────────────────────────────────
# Base URL của ContestantBE (bao gồm hậu tố /api). Local: ContestantBE chạy
# ở port 5001.
VITE_API_URL=http://localhost:5001/api

# ── ChallengeGateway ───────────────────────────────────────────────────────
# Hostname (không kèm scheme/port) mà contestant dùng để kết nối tới challenge.
# Bỏ trống thì portal fallback về '<GATEWAY_DOMAIN>' — luôn set giá trị thật.
VITE_BASE_GATEWAY=localhost
# Port HTTP của gateway; portal ghép thành https://<gateway>:<port>. Default 30038.
VITE_HTTP_PORT=30038
# Port TCP của gateway; portal ghép thành <gateway>:<port>. Default 30037.
VITE_TCP_PORT=30037

# ── Cloudflare Turnstile ───────────────────────────────────────────────────
# Site key (public). Để trống thì widget Turnstile không hiển thị — dùng cho
# local dev. Khi bật, phải khớp với CLOUDFLARE_TURNSTILE_SECRET_KEY của
# ContestantBE, nếu không mọi lần verify đều fail.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
