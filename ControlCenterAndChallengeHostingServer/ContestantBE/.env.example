# ContestantBE
# Copy sang .env rồi chỉnh cho môi trường của bạn:  cp .env.example .env
#
# DotNetEnv Env.Load() tìm .env theo CWD. Khi chạy `dotnet run --project
# ContestantBE` từ thư mục solution thì file được đọc là
# ControlCenterAndChallengeHostingServer/.env, không phải file này. File này
# dùng khi chạy trực tiếp trong thư mục project.
#
# THỨ TỰ ƯU TIÊN: trừ DB_CONNECTION, mọi biến dưới đây được đọc từ bảng
# `configs` trong DB trước (key tương ứng ghi ở comment), env chỉ là fallback
# khi DB không có hoặc để trống. Sửa env mà không thấy đổi thì kiểm tra bảng
# `configs` — ManagementPlatform ghi vào đó.
#
# Giá trị mặc định dưới đây khớp với docker-compose.dev.yml ở repo root.

# ── Database (bắt buộc — chỉ đọc từ env) ───────────────────────────────────
DB_CONNECTION=Server=localhost;Port=3306;Database=ctfd;User=fctf_user;Password=fctf_password;

# ── Redis (bắt buộc — DB key: redis_connection) ────────────────────────────
REDIS_CONNECTION=localhost:6379,password=redis_password,abortConnect=false
# Redis TLS mặc định bật: nếu connection string không có ssl=true thì code tự
# ép Ssl lên. Redis của docker-compose.dev.yml không phục vụ TLS nên local phải
# xin plaintext một cách tường minh. Bị từ chối khi ASPNETCORE_ENVIRONMENT=Production.
REDIS_ALLOW_PLAINTEXT=true
# Chấp nhận certificate Redis mà không verify. Chỉ dùng khi test TLS ở local
# với self-signed cert — không bao giờ bật trong deployment.
REDIS_TLS_INSECURE_SKIP_VERIFY=false
# CA đã ký certificate của Redis server. Set thì connection được verify theo CA
# này; để trống thì verify theo trust store của container.
REDIS_TLS_CA_FILE=

# ── JWT (bắt buộc — DB key: private_key) ───────────────────────────────────
# Phải giống nhau ở tất cả services, kể cả ChallengeGateway.
PRIVATE_KEY=replace_me

# ── DeploymentCenter (bắt buộc — DB key: deployment_service_api) ───────────
DEPLOYMENT_SERVICE_API=http://localhost:5002

# ── Upload storage (bắt buộc — DB key: nfs_mount_path) ─────────────────────
# Deployment trỏ vào NFS share; local dùng thư mục tương đối cũng được.
NFS_MOUNT_PATH=./uploads

# ── Cloudflare Turnstile (optional — DB key: cloudflare_turnstile_secret_key) ──
# Env fallback chấp nhận cả CLOUDFLARE_TURNSTILE_SECRET_KEY và
# TURNSTILE_SECRET_KEY. Để trống thì Turnstile tắt hoàn toàn (local dev).
# Khi bật, phải khớp với VITE_CLOUDFLARE_TURNSTILE_SITE_KEY của ContestantPortal.
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── KYPO sandbox (optional — chỉ cần khi dùng challenge dạng sandbox) ──────
# DB key: kypo_base_url. Default https://vuontre.iahn.hanoi.vn
KYPO_BASE_URL=
# DB key: kypo_realm. Default CRCZP
KYPO_REALM=
# DB key: kypo_client_id. Default CRCZP-Client
KYPO_CLIENT_ID=
# DB key: kypo_client_secret
KYPO_CLIENT_SECRET=
# DB key: kypo_username / kypo_password — tài khoản KYPO dùng gọi API.
KYPO_ADMIN_USER=
KYPO_ADMIN_PASS=
# DB key: kypo_admin_username / kypo_admin_password — admin của Keycloak master
# realm, dùng để map training_run → team. User default là "admin".
KYPO_KEYCLOAK_ADMIN_USER=
KYPO_KEYCLOAK_ADMIN_PASS=
# DB key: kypo_poll_interval_seconds. Chu kỳ poll của KypoTimeoutWatcher (giây).
# Default 10.
KYPO_POLL_INTERVAL_SECONDS=10
# DB key: default_limit_challenges. Số challenge một team được deploy đồng thời
# khi cuộc thi để limit_challenges bằng 0 (cột đó hiểu 0 là không giới hạn).
# Default 5, đặt 0 để giữ nguyên "không giới hạn".
DEFAULT_LIMIT_CHALLENGES=5
# Khóa AES bảo vệ credential KYPO lưu trong DB. Chỉ đọc từ env (không có DB key);
# 32 byte đầu được dùng làm key, để trống nghĩa là mã hóa bằng khóa toàn 0.
KYPO_AES_KEY=replace_me

# ── Kubernetes ─────────────────────────────────────────────────────────────
# Chỉ dùng khi không chạy in-cluster. Bỏ trống thì fallback về ~/.kube/config.
KUBECONFIG=

# ── Runtime ────────────────────────────────────────────────────────────────
# Đặt Production trong deployment; khi đó REDIS_ALLOW_PLAINTEXT bị từ chối.
ASPNETCORE_ENVIRONMENT=Development
