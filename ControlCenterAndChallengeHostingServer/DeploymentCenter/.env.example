# DeploymentCenter
# Copy sang .env rồi chỉnh cho môi trường của bạn:  cp .env.example .env
#
# DotNetEnv Env.Load() tìm .env theo CWD. Khi chạy `dotnet run --project
# DeploymentCenter` từ thư mục solution thì file được đọc là
# ControlCenterAndChallengeHostingServer/.env, không phải file này. File này
# dùng khi chạy trực tiếp trong thư mục project.
#
# Giá trị mặc định dưới đây khớp với docker-compose.dev.yml ở repo root.

# ── Database (bắt buộc) ────────────────────────────────────────────────────
DB_CONNECTION=Server=localhost;Port=3306;Database=ctfd;User=fctf_user;Password=fctf_password;

# ── Redis (bắt buộc) ───────────────────────────────────────────────────────
REDIS_CONNECTION=localhost:6379,password=redis_password,abortConnect=false
# Redis TLS mặc định bật: nếu connection string không có ssl=true thì code tự
# ép Ssl lên. Redis của docker-compose.dev.yml không phục vụ TLS nên local phải
# xin plaintext một cách tường minh. Bị từ chối khi ASPNETCORE_ENVIRONMENT=Production.
REDIS_ALLOW_PLAINTEXT=true
# Chấp nhận certificate Redis mà không verify. Chỉ dùng khi test TLS ở local
# với self-signed cert — không bao giờ bật trong deployment.
REDIS_TLS_INSECURE_SKIP_VERIFY=false
# CA đã ký certificate của Redis server. Set thì connection được verify theo CA
# này; để trống thì verify theo trust store của container.
REDIS_TLS_CA_FILE=

# ── JWT (bắt buộc — phải giống nhau ở tất cả services) ─────────────────────
PRIVATE_KEY=replace_me

# ── RabbitMQ (bắt buộc, trừ RABBIT_VHOST/RABBIT_TLS) ───────────────────────
RABBIT_HOST=localhost
RABBIT_USERNAME=admin
RABBIT_PASSWORD=rabbitmq_password
# Optional — default "/".
RABBIT_VHOST=fctf_deploy
RABBIT_PORT=5672
# Optional — default false. Bật trong deployment (AMQPS).
RABBIT_TLS=false

# ── Argo Workflows ─────────────────────────────────────────────────────────
# Bắt buộc: endpoint của Argo Workflows server.
ARGO_WORKFLOWS_URL=http://localhost:2746
# Bearer token được đọc từ file này trước. Optional — default là service
# account token khi chạy in-cluster.
ARGO_WORKFLOWS_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# Fallback cho local/dev khi file token ở trên không tồn tại. Chạy in-cluster
# thì để trống.
ARGO_WORKFLOWS_TOKEN=replace_me
# WorkflowTemplate dùng cho endpoint "up challenge". Không set thì endpoint đó
# trả lỗi, phần còn lại của service vẫn chạy.
UP_CHALLENGE_TEMPLATE=up-challenge

# ── Timeouts (optional — có default) ───────────────────────────────────────
# Thời gian chờ pod của challenge lên Running (phút). Default 5.
POD_START_TIMEOUT_MINUTES=5
# Thời gian một request được nằm trong hàng đợi deploy (phút). Default 5.
DEPLOYMENT_QUEUE_TIMEOUT_MINUTES=5
# Số message tối đa một cuộc thi được chiếm trong deployment_queue. Hàng đợi
# dùng chung cho mọi cuộc thi, nên không có trần này thì một cuộc thi đông
# người chơi lấp hết chỗ và các cuộc thi khác nhận 429. Default 100, đặt 0 để
# tắt hạn ngạch.
MAX_QUEUED_PER_CONTEST=100

# ── Loki (optional — có default) ───────────────────────────────────────────
# Default http://loki-stack:3100.
LOKI_BASE_URL=http://localhost:3100
# LogQL selector khi query log. Dùng nháy đơn để DotNetEnv không parse nhầm { }.
# Default {app="challenge-gateway"}.
LOKI_QUERY_SELECTOR='{app="challenge-gateway"}'

# ── Secret-key middleware (optional — có default) ──────────────────────────
# Độ lệch thời gian tối đa cho phép khi verify secret key của request nội bộ
# (giây). Chỉ nhận giá trị > 0, ngược lại dùng default của code.
SECRET_KEY_MAX_SKEW_SECONDS=

# ── Kubernetes ─────────────────────────────────────────────────────────────
# Chỉ dùng khi không chạy in-cluster. Bỏ trống thì fallback về ~/.kube/config.
KUBECONFIG=

# ── Runtime ────────────────────────────────────────────────────────────────
# Đặt Production trong deployment; khi đó REDIS_ALLOW_PLAINTEXT bị từ chối.
ASPNETCORE_ENVIRONMENT=Development
