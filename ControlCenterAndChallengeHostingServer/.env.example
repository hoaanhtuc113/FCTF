# ControlCenterAndChallengeHostingServer — .env dùng chung cho cả 4 service
# Copy sang .env rồi chỉnh cho môi trường của bạn:  cp .env.example .env
#
# File này nằm ở thư mục gốc của solution vì DotNetEnv.Env.Load() tìm .env theo
# CWD, mà CWD khi chạy `dotnet run --project <X>` chính là thư mục này. Mỗi
# project cũng có .env.example riêng, chỉ dùng khi chạy trực tiếp bên trong
# thư mục project đó.
#
# Cột "service" ghi rõ biến nào cần cho service nào:
#   BE = ContestantBE, DC = DeploymentCenter,
#   CS = DeploymentConsumer, LS = DeploymentListener
#
# Giá trị mặc định dưới đây khớp với docker-compose.dev.yml ở repo root.

# ── Database (BE, DC, CS, LS — bắt buộc) ───────────────────────────────────
DB_CONNECTION=Server=localhost;Port=3306;Database=ctfd;User=fctf_user;Password=fctf_password;

# ── Redis (BE, DC, CS, LS — bắt buộc) ──────────────────────────────────────
REDIS_CONNECTION=localhost:6379,password=redis_password,abortConnect=false
# Redis TLS mặc định bật: nếu connection string không có ssl=true thì code tự
# ép Ssl lên. Redis của docker-compose.dev.yml không phục vụ TLS nên local phải
# xin plaintext một cách tường minh. Bị từ chối khi ASPNETCORE_ENVIRONMENT=Production.
REDIS_ALLOW_PLAINTEXT=true
# Chấp nhận certificate Redis mà không verify. Chỉ dùng khi test TLS ở local
# với self-signed cert — không bao giờ bật trong deployment.
REDIS_TLS_INSECURE_SKIP_VERIFY=false
# CA đã ký certificate của Redis server. Set thì connection được verify theo CA
# này; để trống thì verify theo trust store của container.
REDIS_TLS_CA_FILE=

# ── JWT (BE, DC, CS, LS — bắt buộc) ────────────────────────────────────────
# Phải giống nhau ở tất cả services, kể cả ChallengeGateway.
PRIVATE_KEY=replace_me

# ── RabbitMQ (DC, CS — bắt buộc, trừ RABBIT_VHOST/RABBIT_TLS) ──────────────
RABBIT_HOST=localhost
RABBIT_USERNAME=admin
RABBIT_PASSWORD=rabbitmq_password
# Optional — default "/".
RABBIT_VHOST=fctf_deploy
RABBIT_PORT=5672
# Optional — default false. Bật trong deployment (AMQPS).
RABBIT_TLS=false

# ── Argo Workflows (DC, CS) ────────────────────────────────────────────────
# Bắt buộc: endpoint của Argo Workflows server.
ARGO_WORKFLOWS_URL=http://localhost:2746
# Bearer token được đọc từ file này trước. Optional — default là service
# account token khi chạy in-cluster.
ARGO_WORKFLOWS_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# Fallback cho local/dev khi file token ở trên không tồn tại. Chạy in-cluster
# thì để trống.
ARGO_WORKFLOWS_TOKEN=replace_me
# CS — bắt buộc: WorkflowTemplate dùng để start challenge.
START_CHALLENGE_TEMPLATE=start-challenge
# DC — WorkflowTemplate cho endpoint "up challenge". Không set thì riêng endpoint
# đó trả lỗi, phần còn lại của service vẫn chạy.
UP_CHALLENGE_TEMPLATE=up-challenge

# ── Timeouts & tuning (optional — có default) ──────────────────────────────
# DC, CS: thời gian chờ pod của challenge lên Running (phút). Default 5.
POD_START_TIMEOUT_MINUTES=5
# DC: thời gian một request được nằm trong hàng đợi deploy (phút). Default 5.
DEPLOYMENT_QUEUE_TIMEOUT_MINUTES=5
# CS: TTL của workflow deploy trên Argo (phút). Default 6.
ARGO_DEPLOY_TTL_MINUTES=6
# CS: số message lấy ra mỗi vòng xử lý. Default 20.
BATCH_SIZE=20
# CS: trần số workflow chạy đồng thời trên Argo. Default 30.
MAX_RUNNING_WORKFLOW=30
# CS: khoảng nghỉ giữa hai vòng poll của worker (giây). Default 2.
WORKER_POLL_INTERVAL_SECONDS=2
# LS: số worker xử lý song song event của challenge watcher. Default 20.
CHALLENGE_WATCHER_WORKER_COUNT=20
# DC: độ lệch thời gian tối đa cho phép khi verify secret key của request nội bộ
# (giây). Chỉ nhận giá trị > 0, ngược lại dùng default của code.
SECRET_KEY_MAX_SKEW_SECONDS=

# ── Loki (DC — optional, có default) ───────────────────────────────────────
# Default http://loki-stack:3100.
LOKI_BASE_URL=http://localhost:3100
# LogQL selector khi query log. Dùng nháy đơn để DotNetEnv không parse nhầm { }.
# Default {app="challenge-gateway"}.
LOKI_QUERY_SELECTOR='{app="challenge-gateway"}'

# ── ContestantBE specific ──────────────────────────────────────────────────
# BE đọc các biến dưới đây từ bảng `configs` trong DB trước, env chỉ là fallback.
# Bắt buộc — DB key: deployment_service_api
DEPLOYMENT_SERVICE_API=http://localhost:5002
# Bắt buộc — DB key: nfs_mount_path. Deployment trỏ vào NFS share.
NFS_MOUNT_PATH=./uploads
# Optional — DB key: cloudflare_turnstile_secret_key (env fallback cũng chấp
# nhận TURNSTILE_SECRET_KEY). Để trống thì Turnstile tắt hoàn toàn; khi bật
# phải khớp với VITE_CLOUDFLARE_TURNSTILE_SITE_KEY của ContestantPortal.
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── KYPO sandbox (BE — optional, chỉ cần khi dùng challenge dạng sandbox) ──
# Xem ContestantBE/.env.example để biết DB key và default của từng biến.
KYPO_BASE_URL=
KYPO_REALM=
KYPO_CLIENT_ID=
KYPO_CLIENT_SECRET=
KYPO_ADMIN_USER=
KYPO_ADMIN_PASS=
KYPO_KEYCLOAK_ADMIN_USER=
KYPO_KEYCLOAK_ADMIN_PASS=
KYPO_POLL_INTERVAL_SECONDS=10
# Khóa AES bảo vệ credential KYPO lưu trong DB — chỉ đọc từ env, không có DB key.
KYPO_AES_KEY=replace_me

# ── Kubernetes (BE, DC, CS, LS) ────────────────────────────────────────────
# Chỉ dùng khi không chạy in-cluster. Bỏ trống thì fallback về ~/.kube/config.
KUBECONFIG=

# ── Runtime (BE, DC, CS, LS) ───────────────────────────────────────────────
# Đặt Production trong deployment; khi đó REDIS_ALLOW_PLAINTEXT bị từ chối.
ASPNETCORE_ENVIRONMENT=Development
